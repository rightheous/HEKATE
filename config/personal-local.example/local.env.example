# Copy to a private env file and replace every placeholder.
HEKATE_RUNTIME_MODE=local
HEKATE_PROJECT_DIR=/absolute/path/to/hekate-checkout
HEKATE_CONFIG_DIR=/absolute/path/to/hekate-checkout/config/personal-local
HEKATE_DATABASE_URL=postgresql+psycopg://hekate:REPLACE_ME@127.0.0.1:5432/hekate_personal_local
HEKATE_NODE_BIN=/absolute/path/to/node-v22.19.0/bin/node
HEKATE_LETTA_URL=ws://127.0.0.1:8283
HEKATE_LETTA_TOKEN=REPLACE_WITH_PRIVATE_APP_SERVER_TOKEN
HEKATE_PROVIDER_GATEWAY_TOKEN=REPLACE_WITH_PRIVATE_GATEWAY_TOKEN
HEKATE_MEMORY_PROJECTION_ENABLED=true
