+function observeProviderAdapterEvent(input: {
+  stage: string;
+  operationId?: string;
+  accountingCallId?: string;
+  providerCallId?: string;
+  channel: "assistant" | "reasoning" | "terminal";
+  contentIndex?: number;
+  messageId?: string;
+  inputText?: string;
+  outputText?: string;
+}): void {
+  const path = process.env.HEKATE_OUTPUT_OBSERVATION_FILE;
+  if (!path) return;
+  const identity = input.operationId ?? input.accountingCallId ?? "unbound";
+  const sequence = (adapterObservationSequences.get(identity) ?? 0) + 1;
+  adapterObservationSequences.set(identity, sequence);
+  const inputBytes = Buffer.from(input.inputText ?? "", "utf8");
+  const outputBytes = Buffer.from(input.outputText ?? "", "utf8");
+  const previous = adapterObservedAssistantBytes.get(identity) ?? 0;
+  const remaining = input.channel === "assistant" ? Math.max(0, 65_536 - previous) : 0;
+  let retained = "";
+  let retainedBytes = 0;
+  if (input.channel === "assistant" && input.inputText) {
+    for (const point of Array.from(input.inputText)) {
+      const pointBytes = Buffer.byteLength(point, "utf8");
+      if (retainedBytes + pointBytes > remaining) break;
+      retained += point;
+      retainedBytes += pointBytes;
+    }
+    adapterObservedAssistantBytes.set(identity, previous + retainedBytes);
+  }
+  appendFileSync(path, `${JSON.stringify({
+    kind: "provider_adapter_event",
+    sequence,
+    stage: input.stage,
+    operation_id: input.operationId ?? null,
+    accounting_call_id: input.accountingCallId ?? null,
+    provider_call_id: input.providerCallId ?? null,
+    channel: input.channel,
+    content_index: input.contentIndex ?? null,
+    message_id: input.messageId ?? null,
