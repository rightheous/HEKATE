+export interface HekateOperationContext {
+  version: 1;
+  operation_id: string;
+  task_id: string;
+  attempt_id: string;
+  agent_registry_id: string;
+  provider_agent_id: string;
+  input_revision: number;
+  fence: number;
+  conversation_id: string;
+}
+
+export function decodeHekateOperationContext(
+  otid: string | null | undefined,
+): HekateOperationContext | undefined {
+  if (!otid?.startsWith("hekate:v1:")) return undefined;
+  try {
+    const value: unknown = JSON.parse(Buffer.from(otid.slice("hekate:v1:".length), "base64url").toString("utf8"));
+    if (!value || typeof value !== "object" || Array.isArray(value)) return undefined;
+    const item = value as Record<string, unknown>;
+    if (
+      item.version !== 1 ||
+      typeof item.operation_id !== "string" ||
+      typeof item.task_id !== "string" ||
+      typeof item.attempt_id !== "string" ||
+      typeof item.agent_registry_id !== "string" ||
+      typeof item.provider_agent_id !== "string" ||
+      typeof item.input_revision !== "number" ||
+      !Number.isSafeInteger(item.input_revision) ||
+      typeof item.fence !== "number" ||
+      !Number.isSafeInteger(item.fence) ||
+      typeof item.conversation_id !== "string"
+    ) return undefined;
+    return item as unknown as HekateOperationContext;
+  } catch {
+    return undefined;
+  }
+}
+
+export function hekateProviderCallHeaders(input: {
+  otid: string | null | undefined;
+  agentId: string;
+  conversationId: string;
+  model: string;
+  maxOutputTokens?: number;
+  callKind: "turn" | "compaction";
+  accountingCallId: string;
+}): Record<string, string> {
+  const context = decodeHekateOperationContext(input.otid);
+  if (!context) {
+    if (process.env.HEKATE_REQUIRE_PROVIDER_BINDING === "1") {
+      throw new Error("HEKATE provider call missing trusted operation context");
+    }
+    return {};
+  }
+  if (context.provider_agent_id !== input.agentId || context.conversation_id !== input.conversationId) {
+    throw new Error("HEKATE provider call binding mismatch");
+  }
+  return {
+    "x-hekate-task-id": context.task_id,
+    "x-hekate-attempt-id": context.attempt_id,
+    "x-hekate-operation-id": context.operation_id,
+    "x-hekate-agent-registry-id": context.agent_registry_id,
+    "x-hekate-provider-agent-id": context.provider_agent_id,
+    "x-hekate-input-revision": String(context.input_revision),
+    "x-hekate-fence": String(context.fence),
+    "x-hekate-conversation-id": context.conversation_id,
+    "x-hekate-accounting-call-id": input.accountingCallId,
+    "x-hekate-call-kind": input.callKind,
+    "x-hekate-model": input.model,
+    "x-hekate-max-output-tokens": input.maxOutputTokens === undefined ? "" : String(input.maxOutputTokens),
+  };
+}
