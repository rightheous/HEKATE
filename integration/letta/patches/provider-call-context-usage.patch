+    emitted_text_delta_sha256: createHash("sha256").update(outputBytes).digest("hex"),
+    ...(input.channel === "assistant" ? {
+      assistant_content_delta: retained,
+      assistant_content_delta_truncated: retainedBytes < inputBytes.byteLength,
+      assistant_content_captured_total_utf8_bytes: previous + retainedBytes,
+    } : {}),
+  })}\n`);
+}
